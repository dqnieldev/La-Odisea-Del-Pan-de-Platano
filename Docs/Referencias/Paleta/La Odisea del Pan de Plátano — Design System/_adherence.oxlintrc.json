{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/hud/**",
              "components/navigation/**",
              "ui_kits/companion/**",
              "ui_kits/juego/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Rubik|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Rubik, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|locked|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActionCard> doesn't accept that prop. Declared props: title, subtitle, icon, locked, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|onDark|style|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: label, onClick, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|danger|dark)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'danger' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|mangrove|dark|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'mangrove' | 'dark' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|image|tone|tagLabel|description|compact|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CharacterCard> doesn't accept that prop. Declared props: name, role, image, tone, tagLabel, description, compact, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CharacterCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ally|rival|neutral|accent)$/]",
        "message": "<CharacterCard> tone must be one of 'ally' | 'rival' | 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GamePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|tone|children|actions|width|style|key|ref|className|style|children)$/]",
        "message": "<GamePanel> doesn't accept that prop. Declared props: title, eyebrow, tone, children, actions, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GamePanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<GamePanel> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:lives|max|size|style|key|ref|className|style|children)$/]",
        "message": "<HeartMeter> doesn't accept that prop. Declared props: lives, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|accent|style|key|ref|className|style|children)$/]",
        "message": "<HudChip> doesn't accept that prop. Declared props: icon, value, label, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|fill|weight|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, fill, weight, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|accent|dark)$/]",
        "message": "<IconButton> variant must be one of 'light' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|image|label|count|collected|active|size|style|key|ref|className|style|children)$/]",
        "message": "<ItemSlot> doesn't accept that prop. Declared props: icon, image, label, count, collected, active, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|tone|height|showValue|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, icon, tone, height, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cook|banana|mangrove|danger)$/]",
        "message": "<ProgressBar> tone must be one of 'cook' | 'banana' | 'mangrove' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ally|ingredient|rival|neutral|accent|dark)$/]",
        "message": "<Tag> tone must be one of 'ally' | 'ingredient' | 'rival' | 'neutral' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|rightIcon|rightLabel|onRight|badge|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, onBack, rightIcon, rightLabel, onRight, badge, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
