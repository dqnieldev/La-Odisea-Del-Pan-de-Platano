  m_Script: {fileID: 11500000, guid: 5d861ae34b8ef2f4d94d93743315c6de, type: 3}
  m_Name: MercadoSalida
  m_EditorClassIdentifier: Odisea::Odisea.UI.ComicSequence
  title: "Acto I \xB7 El racimo dorado"
  music: {fileID: 8300000, guid: 5ef0d719ee6423f42bae2fdd1fe6bb59, type: 3}
  panels:
  - title: El Racimo Dorado
    art: {fileID: 21300000, guid: b58adfb2cecb2f24bbb8887f21d94d36, type: 3}
    caption: "En la cima, Ulises arranca el racimo de pl\xE1tanos m\xE1s maduro y dulce de toda la costa. Con eso, el morral queda completo."
    placeholderNote: "Ulises bajo el tragaluz levantando el racimo dorado; del morral asoman la harina, el az\xFAcar y la canela."
  - title: Circe Escapa
    art: {fileID: 21300000, guid: b9048155eee7c924a896fb2349579304, type: 3}
    caption: "Afuera, Madame Circe se sube a su camioneta y huye entre bocinazos: \xAB\xA1Esto no se ha terminado, panadero!\xBB"
    placeholderNote: "Circe huye en su camioneta azul con sus ayudantes colgados atr\xE1s; Ulises se despide con el racimo en la mano."
  - title: Todo Listo en la Mesa
    art: {fileID: 21300000, guid: a2ce110b1f78ec14bba623870e42fe2d, type: 3}
    caption: "De vuelta en el taller, todo cabe en la mesa: pl\xE1tanos, harina, az\xFAcar de ca\xF1a, canela, huevos, mantequilla, bicarbonato, vainilla y sal. Don Lupe sonr\xEDe: \xABAhora viene lo dif\xEDcil: hornearlo.\xBB"
    placeholderNote: "La mesa de la panader\xEDa con todos los ingredientes en fila; Ulises los presenta y Don Lupe sonr\xEDe de brazos cruzados."
