  m_Script: {fileID: 11500000, guid: 5d861ae34b8ef2f4d94d93743315c6de, type: 3}
  m_Name: HornoSalida
  m_EditorClassIdentifier: Odisea::Odisea.UI.ComicSequence
  title: "Acto II \xB7 El pan sale del horno"
  music: {fileID: 8300000, guid: 44811eca46e6572498f3b20ace1b0458, type: 3}
  musicContinues: 0
  panels:
  - title: El Gigante Cae
    art: {fileID: 21300000, guid: 7e896a9063b797544b496346b0109765, type: 3}
    caption: Embarrado de masa y rodeado de ollas rotas, Polifemo cae sentado. El horno sigue en pie.
    placeholderNote: Polifemo sentado en el suelo, mareado y lleno de masa, entre ollas rotas; Ulises protege el horno con el rodillo.
  - title: Pan Horneado
    art: {fileID: 21300000, guid: 4911f25289661244e95b718b2c78146f, type: 3}
    caption: "Del horno sale un vapor dulce: el pan est\xE1 listo. Ulises saca la charola intacta, con la corteza dorada perfecta."
    placeholderNote: Ulises saca el pan dorado y humeante; Don Lupe aplaude; Polifemo olfatea con la boca hecha agua.
  - title: Una Rebanada
    art: {fileID: 21300000, guid: f22a6e27e3139734f88e6731f77b57f4, type: 3}
    caption: "Ulises le ofrece una rebanada al gigante. Polifemo la prueba\u2026 y se le escapa una l\xE1grima: \xABMis pl\xE1tanos nunca supieron tan bien.\xBB"
    placeholderNote: "Polifemo, sentado, muerde la rebanada llorando de gusto; Don Lupe se r\xEDe; Ulises sonr\xEDe con el plato."
  - title: "La Feria ya Empez\xF3"
    art: {fileID: 21300000, guid: 2439c14571ecabe46a8663d7564db00c, type: 3}
    caption: "Ulises guarda el pan en la canasta de mimbre. Al otro lado de la bah\xEDa brillan las carpas de la feria\u2026 pero la tormenta cerr\xF3 el camino. Polifemo se\xF1ala los manglares: \xABPor La Tovara llegas m\xE1s r\xE1pido.\xBB"
    placeholderNote: "Ulises con la canasta a la espalda; Polifemo se\xF1ala los manglares y la feria al fondo; tormenta; Don Lupe se despide."
