  m_Script: {fileID: 11500000, guid: 5d861ae34b8ef2f4d94d93743315c6de, type: 3}
  m_Name: FestivalEntrada
  m_EditorClassIdentifier: Odisea::Odisea.UI.ComicSequence
  title: El Festival
  music: {fileID: 8300000, guid: 7bda826c9fbc0c6499bcd84e2a390804, type: 3}
  musicContinues: 1
  musicVolume: 1
  panels:
  - title: La Plaza en Fiesta
    art: {fileID: 21300000, guid: 7245215caded3f14aa0bcba58f44bd35, type: 3}
    caption: "Ya pas\xF3 la tormenta. La plaza de San Blas huele a pan de pl\xE1tano y suena a banda: el festival por fin empez\xF3."
    placeholderNote: "Plaza de San Blas de noche despu\xE9s de la lluvia: carpas de colores, papel picado, luces, charcos que brillan; Ulises entra con la canasta vac\xEDa y una sonrisa enorme."
  - title: Viejos Conocidos
    art: {fileID: 21300000, guid: 7e09926952bee8a438a6856a5410c86e, type: 3}
    caption: "Entre la gente lo esperan caras conocidas: Don Lupe, orgulloso; Polifemo, con un plato en cada mano\u2026 y Madame Circe, que finge no estar interesada."
    placeholderNote: Don Lupe saluda desde un puesto de pan; Polifemo come junto a una carpa; Circe, de brazos cruzados junto a otra carpa, mira de reojo.
  - title: El Tablero de Honor
    art: {fileID: 21300000, guid: c79ab5a0e0ae1854d91572bb559fdf27, type: 3}
    caption: "Y en medio de la plaza, el Tablero de Honor del festival guarda cada haza\xF1a de su odisea."
    placeholderNote: Un gran tablero de madera adornado con flores y papel picado, con listones de colores; Ulises lo mira con los ojos brillando.
