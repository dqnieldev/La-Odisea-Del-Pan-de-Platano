  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1472377738}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e665cf70d717ca4b9dae9b560640345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Odisea::Odisea.Level.NpcDialogue
  playerLayers:
    serializedVersion: 2
    m_Bits: 128
  bubble: {fileID: 1265109924}
  bubbleIcon: {fileID: 1492902498}
  keyboardIcon: {fileID: 21300000, guid: e215ed310d2b49a48a9f7eea31979e46, type: 3}
  xboxIcon: {fileID: 21300000, guid: 9978dc13d07f6e64a840f5413c4b2f13, type: 3}
  playStationIcon: {fileID: 21300000, guid: c9d332f652e2f4842a9a24db4833b4a3, type: 3}
  speakerName: Don Lupe
  conversations:
  - requiresDone: 
    lines:
    - "\xA1Ah\xED est\xE1s, muchacho! El festival no espera a nadie."
    - "Antes de irte, baja a la playa y demu\xE9strame que no se te olvid\xF3 lo b\xE1sico."
    - "La puerta de la derecha da al muelle. \xA1Anda!"
  - requiresDone: tutorial
    lines:
    - "Nada mal, nada mal\u2026 Todav\xEDa tienes buenas manos."
    - "Ahora ve al Mercado: ah\xED est\xE1 el mejor pl\xE1tano macho de San Blas."
    - "Y cu\xEDdate de los ayudantes de Circe. No juegan limpio."
  - requiresDone: mercado
    lines:
    - "\xA1Ese pl\xE1tano huele a gloria! Sigue as\xED, muchacho."
    - "El horno y la panader\xEDa te necesitan. No te rindas."
  visual: {fileID: 1918840487}
