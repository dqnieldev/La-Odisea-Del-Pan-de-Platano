      m_Calls: []
  m_text: "<b>Moverse y escaleras</b>\n<size=80%><color=#73594A>A D W S o flechas  \xB7  stick o cruceta</color></size>\n\n<b>Saltar</b> (2 veces = doble salto)\n<size=80%><color=#73594A>Espacio  \xB7  A / Cruz</color></size>\n\n<b>Golpear con el rodillo</b>\n<size=80%><color=#73594A>J o clic  \xB7  X / Cuadrado</color></size>\n\n<b>Lanzar masa</b>\n<size=80%><color=#73594A>K o clic derecho  \xB7  Y / Tri\xE1ngulo</color></size>\n\n<b>Pausa</b>\n<size=80%><color=#73594A>Esc  \xB7  Start</color></size>"
